# EditorConfig helps editors use consistent settings across the repository.
# See https://editorconfig.org for the format and supported editors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{go,mod,sum}]
indent_style = tab

[Makefile]
indent_style = tab

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Trailing whitespace is meaningful in Markdown (it forces a line break).
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
